# The selector is disabled unless a provider is chosen explicitly.
CASCADE_LLM_PROVIDER=off
CASCADE_LLM_MODEL=
CASCADE_LLM_BASE_URL=
CASCADE_LLM_TIMEOUT_S=20

# Set only the credential used by the selected provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CASCADE_LLM_API_KEY=

# Server defaults are safest for a local product run.
CASCADE_HOST=127.0.0.1
CASCADE_CORS_ORIGIN=
